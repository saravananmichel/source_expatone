      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "qualifications",
      "label": "Confirm qualifications, professional licensing and employer registration evidence required for this role.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "arrivalSteps",
      "label": "Employer confirmed permitted work start and any post-arrival registration / residence steps.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "medical",
      "label": "Required medical certificate supplied.",
      "needsDocument": true,
      "role": "Medical certificate",
      "when": "eq:medicalRequired:Yes"
    },
    {
      "key": "police",
      "label": "Required police clearance supplied.",
      "needsDocument": true,
      "role": "Police clearance",
      "when": "eq:policeRequired:Yes"
