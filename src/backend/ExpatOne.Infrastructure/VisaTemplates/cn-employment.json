  "checks": [
    {
      "key": "routeReviewed",
      "label": "Record the current official checklist URL, review date and applicable nationality/filing route; resolve any visa exemption first.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "passportCopy",
      "label": "Applicant passport copy reviewed against the current official validity and blank-page rules.",
      "needsDocument": true,
      "role": "Passport"
    },
    {
      "key": "photo",
      "label": "Photograph prepared to the handling authority specifications.",
      "needsDocument": true,
      "role": "Photograph"
    },
    {
      "key": "lawfulStay",
      "label": "Required lawful residence evidence supplied.",
      "needsDocument": true,
      "role": "Residence evidence",
