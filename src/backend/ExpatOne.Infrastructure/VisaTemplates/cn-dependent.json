  "checks": [
    {
      "key": "routeReviewed",
      "label": "Record the current official checklist URL, review date and applicable nationality/filing route; resolve any visa exemption first.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "passportCopy",
      "label": "Applicant passport copy reviewed against the current official validity and blank-page rules.",
      "needsDocument": true,
      "role": "Passport"
    },
    {
      "key": "photo",
      "label": "Photograph prepared to the handling authority specifications.",
      "needsDocument": true,
      "role": "Photograph"
    },
    {
      "key": "lawfulStay",
      "label": "Required lawful residence evidence supplied.",
      "needsDocument": true,
      "role": "Residence evidence",
      "when": "eq:lawfulStayRequired:Yes"
    },
    {
      "key": "translation",
      "label": "Required certified translations supplied.",
      "needsDocument": true,
      "role": "Official translation",
      "when": "translation"
    },
    {
      "key": "formReviewed",
      "label": "Applicant has checked all answers and declarations against original documents.",
      "needsDocument": false
    },
    {
      "key": "additional",
      "label": "Record additional mission/employer requirements and confirm they are supplied, or explain why none apply.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "sponsorPassport",
      "label": "Sponsor passport copy supplied.",
      "needsDocument": true,
      "role": "Sponsor passport"
    },
    {
      "key": "sponsorPermit",
      "label": "Sponsor immigration status evidence supplied.",
      "needsDocument": true,
      "role": "Sponsor permission"
    },
    {
      "key": "relationshipEvidence",
      "label": "Marriage / birth / adoption / other accepted relationship evidence supplied.",
      "needsDocument": true,
      "role": "Relationship evidence"
    },
    {
      "key": "familyEligibility",
      "label": "Confirm eligible relationship, age/dependency rules, sponsor permission and intended duration under the chosen route.",
      "needsDocument": false,
      "noteRequired": true
    },
    {
      "key": "invitation",
      "label": "Invitation from the foreign resident supplied.",
      "needsDocument": true,
      "role": "Invitation"
    },
    {
      "key": "formerNationality",
      "label": "Review required former Chinese passport / previous visa evidence for former citizens.",
      "needsDocument": false,
      "noteRequired": true,
      "when": "eq:formerChineseCitizen:Yes"
    }
