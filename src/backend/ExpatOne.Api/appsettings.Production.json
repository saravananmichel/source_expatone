{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "TrustedCidrs": []
  },
  "RateLimiting": {
    "AiEndpoints": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "EmergencyAi": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
