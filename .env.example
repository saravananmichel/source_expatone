# Native application configuration. Never commit a real .env.
# ASP.NET does not load dotenv files itself: export these keys or use Compose env_file.
# Full EC2 production configuration: deploy/ec2/.env.example and README.md.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=expatone;Username=postgres;Password=
Aws__Region=ap-southeast-5
Aws__S3BucketName=
# AWS credentials come from the normal SDK credential chain / EC2 instance role.
Firebase__ProjectId=
Firebase__CredentialPath=
Gemini__ApiKey=
DocumentIntelligence__Enabled=true
DocumentIntelligence__Provider=Local
DocumentIntelligence__EnableFallback=false
DocumentIntelligence__ServiceUrl=http://127.0.0.1:8090/
DocumentIntelligence__ServiceKey=
DocumentIntelligence__ConfigurationVersion=local-qwen3-4b-v1
# FastAPI settings; service key must match DocumentIntelligence__ServiceKey.
DOCUMENT_AI_SERVICE_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OCR_LANGUAGES=eng
# Flutter consumes this through --dart-define, not dotenv automatically.
API_BASE_URL=http://10.0.2.2:5000/api
