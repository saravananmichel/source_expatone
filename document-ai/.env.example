# Set actual keys via secret storage. Never commit a real key.
DOCUMENT_AI_SERVICE_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OCR_LANGUAGES=eng

# OLLAMA_URL is still accepted if OLLAMA_BASE_URL is unset.
DOCUMENT_AI_VALIDATE_STARTUP=false
DOCUMENT_AI_ENVIRONMENT=Development
DOCUMENT_AI_REQUEST_SECONDS=900
OLLAMA_BATCH_TIMEOUT_SECONDS=180
