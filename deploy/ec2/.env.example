# Used by compose and ASP.NET's native double-underscore configuration.
# Copy to .env (gitignored), chmod 600, and supply real values securely.
ConnectionStrings__DefaultConnection=Host=YOUR_RDS_HOST;Port=5432;Database=expatone;Username=expatone;Password=REPLACE_ME;SSL Mode=VerifyFull
Aws__Region=ap-southeast-5
Aws__S3BucketName=YOUR_PRIVATE_BUCKET
Firebase__ProjectId=YOUR_FIREBASE_PROJECT
# Single-quoted compact service-account JSON; see secure import command in README.
Firebase__CredentialJson=
DOCUMENT_AI_SERVICE_KEY=REPLACE_WITH_RANDOM_32_BYTE_KEY
# Existing non-document AI features still need this key. Document fallback is disabled.
Gemini__ApiKey=
OCR_LANGUAGES=eng+msa+tam+chi_sim
# ALB target health checks use private-IP Host headers; keep * unless allowing those too.
AllowedHosts=*
# Restrict to your actual VPC subnet range. Include the Compose bridge if checking locally.
ForwardedHeaders__TrustedCidrs__0=YOUR_VPC_CIDR
